{
  "name": "pas",
  "displayName": "Pas (Turkce Rust)",
  "description": "Rust'ı Türkçe anahtar sözcüklerle yaz: renklendirme, Türkçe hata mesajları, tanıma gitme ve tamamlama.",
  "version": "0.3.0",
  "publisher": "plyground",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "simge.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kasimtmc/Pas"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Education",
    "Linters"
  ],
  "keywords": [
    "pas",
    "rust",
    "türkçe",
    "turkish",
    "eğitim"
  ],
  "main": "./out/eklenti.js",
  "contributes": {
    "languages": [
      {
        "id": "pas",
        "aliases": [
          "Pas",
          "pas"
        ],
        "extensions": [
          ".pas"
        ],
        "configuration": "./dil-yapilandirmasi.json"
      }
    ],
    "grammars": [
      {
        "language": "pas",
        "scopeName": "source.pas",
        "path": "./sozdizimi/pas.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "pas.calistir",
        "title": "Çalıştır",
        "category": "Pas",
        "icon": "$(play)"
      },
      {
        "command": "pas.kur",
        "title": "cargo-pas'ı kur",
        "category": "Pas"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "pas.calistir",
          "when": "resourceExtname == .pas"
        }
      ]
    },
    "configuration": {
      "title": "Pas",
      "properties": {
        "pas.cargoPasYolu": {
          "type": "string",
          "default": "",
          "description": "cargo-pas programının yolu. Boş bırakılırsa PATH ve ~/.cargo/bin içinde aranır."
        }
      }
    }
  },
  "scripts": {
    "sozdizimi": "node betikler/sozdizimi-uret.mjs",
    "derle": "npm run sozdizimi && tsc -p . --noEmit && esbuild src/eklenti.ts --bundle --minify --outfile=out/eklenti.js --external:vscode --format=cjs --platform=node --target=node18",
    "test-derle": "esbuild src/test/calistir.ts src/test/testler.ts --outdir=out/test --format=cjs --platform=node --target=node18 --bundle --external:vscode --external:@vscode/test-electron",
    "test": "npm run derle && npm run test-derle && node out/test/calistir.js",
    "paketle": "npm run derle && vsce package --no-dependencies --out pas.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
